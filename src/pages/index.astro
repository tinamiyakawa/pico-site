---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
---

<Base>
  <section class="hero">
    <p class="address display">
      <a href="https://maps.google.com/?q=365+19th+Street,+Oakland,+CA" target="_blank" rel="noopener">
        365 19th Street, Oakland, CA
      </a>
    </p>

    <h1 class="wordmark">
      <Logo />
    </h1>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(2.5rem, 7vw, 5.5rem) var(--gutter) clamp(3rem, 6vw, 4.5rem);
  }

  .address {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.5rem);
    text-align: center;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
  }

  .wordmark {
    margin: 0;
    line-height: 0;
  }

  @media (max-width: 600px) {
    .hero {
      padding: 9.4vw 3.85vw 12vw;
    }

    .address {
      font-size: 5.95vw;
      margin-bottom: 13vw;
    }
  }

  .wordmark :global(.logo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1572 / 1097;
  }

  /* Mobile design stretches the wordmark taller */
  @media (max-width: 600px) {
    .wordmark :global(.logo) {
      aspect-ratio: 643 / 521;
    }
  }
</style>
