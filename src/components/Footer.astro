---
const year = 2027;
---

<footer class="site-footer">
  <div class="signup">
    <h2 class="display">Keep in touch for updates &amp; news</h2>

    <!--
      Mailchimp signup. Uses Mailchimp's JSON endpoint so visitors stay on the
      page and see the thank-you message below. Without JavaScript the form
      still works by opening Mailchimp's own confirmation page.
    -->
    <form
      action="https://linktr.us21.list-manage.com/subscribe/post?u=7244b5026781839856dfa5d4f&amp;id=02a6891739&amp;f_id=000a98e6f0"
      method="post"
      target="_blank"
      class="email-form"
      id="signup-form"
      novalidate
    >
      <!-- Mailchimp spam trap: real people never fill this in -->
      <div class="visually-hidden" aria-hidden="true">
        <input type="text" name="b_7244b5026781839856dfa5d4f_02a6891739" tabindex="-1" value="" autocomplete="off" />
      </div>

      <label for="email" class="visually-hidden">Email address</label>
      <input
        id="email"
        type="email"
        name="EMAIL"
        placeholder="Email Address"
        autocomplete="email"
        required
      />
      <button type="submit" aria-label="Subscribe">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3 12h17M14 5.5l6.5 6.5-6.5 6.5" />
        </svg>
      </button>
    </form>

    <p class="form-message" id="signup-message" role="status" aria-live="polite"></p>
  </div>

  <p class="copyright">&copy; {year} Pico. All rights reserved.</p>
</footer>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const message = document.getElementById('signup-message') as HTMLParagraphElement | null;

  // Messages shown under the field. Edit the wording here.
  const TEXT = {
    success: "Thank you! We'll be in touch.",
    confirm: 'Almost there! Check your inbox to confirm.',
    already: "You're already on the list. Thank you!",
    invalid: 'Please enter a valid email address.',
    error: 'Something went wrong. Please try again.',
  };

  function show(text: string, state: 'ok' | 'error') {
    if (!message) return;
    message.textContent = text;
    message.dataset.state = state;
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const email = (form.querySelector('input[name="EMAIL"]') as HTMLInputElement).value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      show(TEXT.invalid, 'error');
      return;
    }

    // Mailchimp only allows cross-site signups via JSONP (a <script> callback).
    const callback = 'mcSignup' + Date.now();
    const params = new URLSearchParams(new FormData(form) as any);
    params.set('c', callback);
    const url = form.action.replace('/post?', '/post-json?') + '&' + params.toString();

    const script = document.createElement('script');
    const cleanup = () => {
      delete (window as any)[callback];
      script.remove();
    };
    const timer = setTimeout(() => {
      cleanup();
      show(TEXT.error, 'error');
    }, 10000);

    (window as any)[callback] = (res: { result: string; msg: string }) => {
      clearTimeout(timer);
      cleanup();
      const msg = (res.msg || '').toLowerCase();
      if (res.result === 'success') {
        show(msg.includes('confirm') ? TEXT.confirm : TEXT.success, 'ok');
        form.classList.add('done');
        form.reset();
      } else if (msg.includes('already subscribed')) {
        show(TEXT.already, 'ok');
        form.classList.add('done');
      } else if (msg.includes('invalid') || msg.includes('valid email')) {
        show(TEXT.invalid, 'error');
      } else {
        show(TEXT.error, 'error');
      }
    };

    script.src = url;
    script.onerror = () => {
      clearTimeout(timer);
      cleanup();
      show(TEXT.error, 'error');
    };
    show('', 'ok');
    document.body.appendChild(script);
  });
</script>

<style>
  .site-footer {
    background: var(--maroon);
    color: var(--cream);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.5rem 2rem;
    padding: clamp(2rem, 4vw, 2.75rem) var(--gutter) clamp(2rem, 4vw, 2.75rem);
  }

  h2 {
    margin: 0 0 1.75rem;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .email-form {
    display: flex;
    align-items: center;
    width: min(26rem, 100%);
    border: 1.5px solid currentColor;
    border-radius: 999px;
    padding: 0.2rem 0.35rem 0.2rem 1.1rem;
  }

  .email-form:focus-within {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  input[type='email'] {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 1.15rem;
    padding: 0.7rem 0;
  }

  input[type='email']::placeholder {
    color: inherit;
    opacity: 1;
  }

  input[type='email']:focus {
    outline: none;
  }

  button {
    display: grid;
    place-items: center;
    background: none;
    border: 0;
    color: inherit;
    padding: 0.5rem;
    cursor: pointer;
    transition: transform 0.15s ease;
  }

  button:hover {
    transform: translateX(3px);
  }

  .copyright {
    margin: 0;
    font-size: 1.15rem;
  }

  /* Thank-you / error message under the field */
  .form-message {
    margin: 0.9rem 0 0;
    min-height: 1.4em;
    font-size: 1.1rem;
  }

  .form-message:empty {
    margin: 0;
    min-height: 0;
  }

  /* After a successful signup, hide the field and leave just the message */
  .email-form.done {
    display: none;
  }

  .email-form.done + .form-message {
    margin-top: 0;
    font-size: 1.15rem;
  }

  /* Mobile: full-width heading + email field, no copyright line */
  @media (max-width: 600px) {
    .site-footer {
      display: block;
      padding: 5.5vw 5.7vw 7.5vw;
    }

    .signup {
      width: 100%;
    }

    h2 {
      font-size: 5.95vw;
      margin-bottom: 4.2vw;
      white-space: nowrap;
    }

    .email-form {
      width: 100%;
      height: 10.3vw;
      padding-left: 3.7vw;
    }

    input[type='email'] {
      font-size: max(16px, 3.9vw);
      padding: 0;
    }

    .copyright {
      display: none;
    }

    .form-message,
    .email-form.done + .form-message {
      font-size: max(16px, 3.9vw);
    }
  }
</style>
