---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header display">
  <a href="/menu" class="nav-link left" aria-current={path === '/menu' ? 'page' : undefined}>
    Spring Menu
  </a>

  <a href="/" class="tagline">
    A Bar &amp; Restaurant<br />Coming Soon
  </a>

  <a href="/about" class="nav-link right" aria-current={path === '/about' ? 'page' : undefined}>
    <span class="dot" aria-hidden="true"></span>About
  </a>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) var(--gutter) 0;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
  }

  .tagline {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .tagline:hover {
    text-decoration: none;
  }

  .left {
    justify-self: start;
  }

  .right {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
  }

  .dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 560px) {
    .site-header {
      grid-template-columns: 1fr 1fr;
      row-gap: 1.25rem;
    }

    .tagline {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
